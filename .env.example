# Terabox Downloader Configuration

# API endpoint used for extracting direct download links.
# If you leave this blank, the app will use a default public fallback API for testing.
TERABOX_API_ENDPOINT="https://terabox-dl.vkrdownloader.vercel.app/api?data="

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_ID=""

# Local Telegram Bot API Server Configuration (Unlocks 2GB upload limit instead of 50MB)
# Obtain API_ID & API_HASH from https://my.telegram.org
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""
# Set to http://127.0.0.1:8081 if running local bot api server
TELEGRAM_LOCAL_API_URL=""

# Terabox Downloader Credentials (Optional for automated login refresh)
TERABOX_EMAIL=""
TERABOX_PASSWORD=""
TERABOX_NDUS=""

# Shared cookie store path. Defaults to scraper/cookie_store.json.
TERABOX_COOKIE_STORE=""
